[Unit]
Description=Envia ao lojista, ao fim do dia, as perguntas sobre respostas que ele editou (tripat3s)
Documentation=https://github.com/joaocarvalhini/Outlook-Reply-Assistant
After=network-online.target
Wants=network-online.target
# Sem OnFailure: falhar a enviar as perguntas não afeta nenhum cliente, e a
# mensagem fica impressa no journal para seguir à mão. Acordar alguém por
# causa disso seria ruído.

[Service]
Type=oneshot

User=assistente
Group=assistente
WorkingDirectory=/opt/assistente
# Três padrões: a correr todos os dias, a mensagem tem de se ler de pé. Cinco
# eram para a cadência semanal, quando havia uma semana de casos acumulados.
#
# O --enviar marca os casos como revistos assim que a mensagem sai. Sem isso,
# a correr sozinho todas as noites, reenviava os mesmos casos indefinidamente.
ExecStart=/opt/assistente/.venv/bin/python /opt/assistente/aprender.py --perguntar 3 --enviar

# Vai ao Graph buscar o email original de cada caso, mais uma chamada ao
# modelo. Cinco minutos é folga larga.
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/assistente

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
