[Unit]
Description=Perguntas diárias ao lojista, ao fim do dia (tripat3s)
Requires=tripat3s-assistente-perguntas.service

[Timer]
# Todos os dias ao fim do dia, e só quando há alguma coisa a perguntar.
#
# Diário e não semanal por causa da memória dele: ao fim do dia ainda se
# lembra do email que editou de manhã. À segunda seguinte já não, e uma
# pergunta sobre um caso de que já não se lembra ou não tem resposta ou tem
# uma resposta inventada -- que é pior, porque vira regra.
#
# O preço é o risco de habituação, e paga-se de duas maneiras: nas noites sem
# divergências não sai mensagem nenhuma, e o máximo é de três casos.
#
# OnCalendar e não OnUnitActiveSec: aqui a hora do dia importa. Com fuso
# explícito, senão em UTC isto cai uma hora antes no verão.
OnCalendar=*-*-* 19:00 Europe/Lisbon

# Sem Persistent: se o servidor estiver em baixo às 19h, o dia seguinte
# apanha tudo à mesma -- as divergências ficam à espera na base de dados.
# Com Persistent, uma reinicialização às 3h da manhã mandava-lhe a mensagem
# às 3h da manhã.

RandomizedDelaySec=5min

Unit=tripat3s-assistente-perguntas.service

[Install]
WantedBy=timers.target
