# Secrets and local state
.env
assistente.db
logs/
# Cópias de segurança do registo, feitas pelo manutencao.py. São o mesmo
# conteúdo do assistente.db: correspondência de clientes.
backups/

# Documentos gerados para entregar ao cliente, não fazem parte do código
entregas/

# Client knowledge bases are private
clients/

# Evaluation sets built from a real mailbox. Even anonymised, these are the
# client's correspondence and do not belong in a shared repository.
eval/real-*.json

# Obsidian. A documentação em docs/ é o que interessa versionar; a configuração
# do cofre é estado local de quem o abre (tema, painéis abertos, posição do
# grafo) e muda a cada sessão. Abrir a raiz do repositório como cofre cria esta
# pasta — não a comitar.
.obsidian/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
