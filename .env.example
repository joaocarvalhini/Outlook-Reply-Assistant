# Copiar para .env e preencher. O .env nunca vai para o repositório.

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet 5 por omissão. A base de conhecimento cacheia nos dois modelos (medido
# a 26/08/2026: 28929 tokens no Sonnet 5, 22092 no Haiku 4.5, contra mínimos de
# 1024 e 4096). O Haiku é ~3x mais barato e não perde clientes, mas escala mais
# casos que sabia resolver: precisão de escalação de 77% contra 91%.
MODELO=claude-sonnet-5

# --- Microsoft Graph (registo de aplicação, permissões de aplicação) --------
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=
MAILBOX=info@tripat3s.com

# --- Shopify (app privada, Dev Dashboard, scope read_orders só) -------------
# SHOPIFY_STORE é o domínio *.myshopify.com da loja, não o domínio público.
SHOPIFY_STORE=xxxxxx.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Comportamento ----------------------------------------------------------
KNOWLEDGE_DIR=knowledge
BLOCKLIST_FILE=blocklist.txt
DB_FILE=assistente.db
MAX_BODY_CHARS=4000
# Contexto do fio: quantas mensagens anteriores acompanham o email novo, e
# quanto de cada uma. Muitas respostas de cliente são curtas ("e quando
# envia?") e só fazem sentido com o que veio antes.
THREAD_MESSAGES=8
THREAD_CHARS=400

# --- Capacidades, para ativar por fases -------------------------------------
# Resolução de identidade por níveis: encontra a encomenda também quando o
# cliente escreve de outro email (com outro indício que o identifique) ou
# quando não cita número nenhum. Desligar dá o comportamento anterior, que só
# encontrava a encomenda com número mais email exato da compra.
ENABLE_ORDER_IDENTITY_RESOLUTION=true

# true = decide tudo e regista, mas não escreve nada na caixa. Primeira semana.
DRY_RUN=true

# --- Marca -------------------------------------------------------------------
# A assinatura entra tal e qual na última linha do email. A loja assina só com o
# nome, em minúsculas, sem cargo nem "Equipa de".
COMPANY_NAME=tripat3s
SIGNATURE=tripat3s

# --- Categorias usadas como marcadores no Outlook ---------------------------
DRAFTED_CATEGORY=IA-Rascunhado
ESCALATED_CATEGORY=Precisa de humano

# Aparece no topo de cada rascunho. Se esta linha chegar a um cliente, ficamos a
# saber no próprio dia que ninguém está a rever. Esvaziar para desligar.
DRAFT_PREFIX=--- rascunho automático · rever e apagar esta linha ---

# Dossiês para casos escalados acionáveis (cancelamento, reembolso, troca...).
# Sem efeito na caixa: só acrescenta campos ao registo local, lidos pelo
# dossie.py. Desligar volta a escalações sem caso preparado.
ENABLE_PRE_DRAFTS=true

# --- Alerta de falha ---------------------------------------------------------
# Opcional. Sem isto, uma passagem que falhe fica só no journal
# (journalctl -u tripat3s-assistente), visível só a quem for lá olhar.
# Com um endereço aqui, deploy/alertar.py (chamado pelo systemd via
# OnFailure=) envia também um POST de texto simples para fora da máquina.
# Serve qualquer endpoint que aceite isso -- a forma mais rápida de testar é
# um tópico grátis em https://ntfy.sh, sem conta nem chave: escolhe um nome
# de tópico só teu e usa https://ntfy.sh/o-teu-topico aqui, depois assina
# esse tópico no telemóvel ou no browser.
ALERTA_WEBHOOK_URL=

# --- Verificação de segurança diária -----------------------------------------
# Opcional, mas fortemente recomendado. A restrição a esta caixa (o
# Mail.ReadWrite de aplicação por si só dá acesso a TODAS as caixas do
# inquilino) vem de um New-ApplicationAccessPolicy do Exchange, aplicado fora
# deste repositório -- se algum dia for removido, nada o assinala a não ser
# esta verificação.
#
# Preencher com o endereço de OUTRA caixa real do mesmo inquilino Microsoft
# 365 (um colega, uma caixa antiga, qualquer uma que não seja esta). Uma vez
# por dia, a passagem tenta ler essa caixa: se conseguir, é um alarme de
# segurança (a política deixou de restringir) e a passagem para com um erro
# alto para o systemd disparar o alerta (ver ALERTA_WEBHOOK_URL acima). Sem
# um endereço aqui, a verificação fica desligada -- não há um genérico que
# sirva para qualquer instalação.
OUTRA_CAIXA_VERIFICACAO=
