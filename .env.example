# Copy to .env and fill in. Never commit .env.

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLASSIFIER_MODEL=claude-haiku-4-5
REPLY_MODEL=claude-haiku-4-5
MAX_TOKENS=1024

# --- Microsoft Graph (app registration, application permissions) ------------
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=
MAILBOX=apoio@loja.pt

# --- Behaviour --------------------------------------------------------------
KNOWLEDGE_DIR=knowledge
BLOCKLIST_FILE=blocklist.txt
STATE_FILE=state.json
POLL_SECONDS=300
MAX_BODY_CHARS=4000

# true = classify and draft, but never write to the mailbox. Use for the first run.
DRY_RUN=true

# --- Branding (appears in the prompt and the signature) ---------------------
COMPANY_NAME=A Loja
ASSISTANT_NAME=Assistente
SIGNATURE=Equipa de Apoio ao Cliente

# --- Outlook categories used as state markers -------------------------------
DRAFTED_CATEGORY=IA-Rascunhado
ESCALATED_CATEGORY=Precisa de humano

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=logs/assistant.log
